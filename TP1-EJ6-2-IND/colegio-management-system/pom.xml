<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM (Project Object Model) - Archivo de configuración de Maven
    Define las dependencias y plugins necesarios para el proyecto Spring Boot
    
    Dependencias principales:
    - spring-boot-starter-web: Para crear aplicaciones web REST
    - spring-boot-starter-thymeleaf: Motor de plantillas para las vistas HTML
    - spring-boot-starter-data-jpa: ORM para persistencia con JPA/Hibernate
    - spring-boot-starter-security: Módulo de seguridad con autenticación y autorización
    - postgresql: Driver JDBC para base de datos PostgreSQL
    - lombok: Reduce código boilerplate (getters, setters, constructors)
    - spring-boot-starter-mail: Para envío de correos electrónicos
    - validation-api y hibernate-validator: Para validación de DTOs
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <!-- Padre: Spring Boot Starter Parent -->
    <!-- Proporciona configuraciones predeterminadas y gestión de dependencias -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    
    <!-- Información del proyecto -->
    <groupId>com.colegio</groupId>
    <artifactId>colegio-management-system</artifactId>
    <version>1.0.0</version>
    <name>Colegio Management System</name>
    <description>Sistema de gestión escolar con arquitectura MVC, Spring Boot y PostgreSQL</description>
    
    <!-- Propiedades del proyecto -->
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    
    <!-- Dependencias del proyecto -->
    <dependencies>
        <!-- Spring Boot Web: Incluye Spring MVC, Tomcat embebido, REST APIs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- Thymeleaf: Motor de plantillas para generar HTML dinámico en el servidor -->
        <!-- Permite integrar vistas con el backend usando expresiones ${} y th:* attributes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        
        <!-- Spring Data JPA: Capa de persistencia con Hibernate como implementación -->
        <!-- Proporciona repositorios CRUD automáticos y consultas derivadas de nombres de métodos -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <!-- Spring Security: Autenticación y autorización basada en roles -->
        <!-- Implementa filtros de seguridad, encriptación BCrypt, CSRF protection -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        
        <!-- Thymeleaf + Spring Security: Integración de tags de seguridad en plantillas -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        
        <!-- PostgreSQL Driver: Conector JDBC para base de datos PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <!-- Lombok: Generación automática de getters, setters, constructors, builders -->
        <!-- Reduce código repetitivo mediante anotaciones como @Data, @Builder, @NoArgsConstructor -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        
        <!-- Spring Boot Mail: Envío de correos electrónicos con JavaMailSender -->
        <!-- Soporta plantillas HTML, adjuntos, múltiples destinatarios -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        
        <!-- Validación: Bean Validation API para validar DTOs y entidades -->
        <!-- Anotaciones como @NotNull, @Size, @Email, @Pattern -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- DevTools: Recarga automática durante desarrollo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        
        <!-- Testing: JUnit 5, Mockito, Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Security Test: Utilidades para testear seguridad -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <!-- Plugins de build -->
    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin: Empaqueta la aplicación como JAR ejecutable -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
